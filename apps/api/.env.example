# ============================================================
# Nexus Links — API Environment Configuration
# Copy to .env and fill in values. All variables are validated.
# ============================================================

# --- App ---
NODE_ENV=development
LOG_LEVEL=debug
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus-links
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=your-super-secret-key-that-is-at-least-32-chars-long
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=nexuslinks
JWT_AUDIENCE=nexuslinks-api

# --- Cookies ---
COOKIE_SECURE=false

# --- Security ---
PASSWORD_SALT_ROUNDS=12
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexuslinks.com
EMAIL_ENABLED=false

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:3001

# --- Metrics ---
METRICS_ENABLED=true
